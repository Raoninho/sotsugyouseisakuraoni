<div class="mx-auto max-w-4xl px-4 py-10">
  <%= link_to "← 練習場一覧に戻る",
      golf_ranges_path,
      class: "mb-6 inline-block text-sm font-medium text-green-700 hover:underline" %>

  <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-bold text-green-900">
      <%= @golf_range.name %>
    </h1>

    <p class="mt-3 text-gray-600">
      <%= @golf_range.address %>
    </p>

    <section class="mt-8">
      <h2 class="border-b border-gray-700 pb-2 text-lg font-bold text-gray-900">
        施設情報
      </h2>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <p class="text-sm text-gray-500">営業時間</p>
          <p class="text-gray-800">
            <%= @golf_range.opening_hours.presence || "情報なし" %>
          </p>
        </div>

        <div>
          <p class="text-sm text-gray-500">打席数</p>
          <p class="text-gray-800">
            <%= @golf_range.booth_count || "情報なし" %>
          </p>
        </div>

        <div>
          <p class="text-sm text-gray-500">ヤード数</p>
          <p class="text-gray-800">
            <%= @golf_range.yard_length ? "#{@golf_range.yard_length}ヤード" : "情報なし" %>
          </p>
        </div>

        <div>
          <p class="text-sm text-gray-500">駐車場</p>
          <p class="text-gray-800">
            <% if @golf_range.parking_available.nil? %>
              情報なし
            <% elsif @golf_range.parking_available? %>
              あり
            <% else %>
              なし
            <% end %>
          </p>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="border-b border-gray-700 pb-2 text-lg font-bold text-gray-900">
        ボール料金
      </h2>

      <% [
        ["平日", @golf_range.ball_prices.select(&:weekday?)],
        ["土日祝", @golf_range.ball_prices.select(&:weekend?)]
      ].each do |label, prices| %>

        <div class="mt-6">
          <h3 class="mb-3 font-semibold text-green-800">
            <%= label %>
          </h3>

          <% if prices.any? %>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead class="bg-green-50">
                  <tr>
                    <th class="border border-gray-600 px-3 py-3 text-left">
                      階数
                    </th>
                    <th class="border border-gray-600 px-3 py-3 text-left">
                      時間帯
                    </th>
                    <th class="border border-gray-600 px-3 py-3 text-left">
                      料金
                    </th>
                  </tr>
                </thead>

                <tbody>
                  <% prices.each do |price| %>
                    <tr>
                      <td class="border border-gray-600 px-3 py-3">
                        <%= price.floor_number ? "#{price.floor_number}階" : "全階共通" %>
                      </td>

                      <td class="border border-gray-600 px-3 py-3">
                        <% if price.start_time && price.end_time %>
                          <%= "#{price.start_time.strftime('%H:%M')}〜#{price.end_time.strftime('%H:%M')}" %>
                        <% else %>
                          終日
                        <% end %>
                      </td>

                      <td class="border border-gray-600 px-3 py-3 font-medium">
                        <%= number_with_precision(
                            price.price_per_ball,
                            precision: 2,
                            strip_insignificant_zeros: true
                        ) %>円/球
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">
              情報なし
            </p>
          <% end %>
        </div>
      <% end %>
    </section>


    <%# 公式サイトURLはhttp/httpsのみ許可する %>
    <% if (website_url = @golf_range.safe_official_website_url) %>
      <div class="mt-8 border-t border-gray-200 pt-6">
        <a href="<%= website_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-block rounded-lg bg-green-700 px-5 py-3 text-sm font-semibold text-white hover:bg-green-800">
          公式サイトを見る
        </a>
      </div>
    <% end %>
