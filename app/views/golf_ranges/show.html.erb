<div class="mx-auto max-w-5xl px-4 py-8">
  <%= link_to "← 練習場一覧に戻る",
      golf_ranges_path,
      class: "text-green-800 hover:underline" %>

  <div class="mt-6 rounded-xl bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-bold text-green-900">
      <%= @golf_range.name %>
    </h1>

    <p class="mt-3 text-gray-600">
      <%= @golf_range.address.presence || "情報なし" %>
    </p>

    <h2 class="mt-8 border-b pb-2 text-xl font-bold">
      施設情報
    </h2>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <p class="text-sm text-gray-500">営業時間</p>
        <p><%= @golf_range.opening_hours.presence || "情報なし" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">打席数</p>
        <p><%= @golf_range.booth_count ? "#{@golf_range.booth_count}打席" : "情報なし" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">ヤード数</p>
        <p><%= @golf_range.yard_length ? "#{@golf_range.yard_length}ヤード" : "情報なし" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">駐車場</p>
        <p>
          <%= if @golf_range.parking_available.nil?
                "情報なし"
              elsif @golf_range.parking_available?
                "あり"
              else
                "なし"
              end %>
        </p>
      </div>
    </div>

    <h2 class="mt-8 border-b pb-2 text-xl font-bold">
      ボール料金
    </h2>

    <% if @golf_range.ball_prices.empty? %>
      <p class="mt-4 text-gray-500">
        料金情報なし
      </p>
    <% else %>
      <% { "平日" => "weekday", "土日祝" => "weekend" }.each do |label, day_type| %>
        <% prices = @golf_range.ball_prices.select { |price| price.day_type == day_type } %>

        <h3 class="mt-6 text-lg font-semibold text-green-800">
          <%= label %>
        </h3>

        <% if prices.empty? %>
          <p class="mt-2 text-gray-500">情報なし</p>
        <% else %>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <thead class="bg-green-50">
                <tr>
                  <th class="border p-3">階数</th>
                  <th class="border p-3">時間帯</th>
                  <th class="border p-3">料金</th>
                </tr>
              </thead>
              <tbody>
                <% prices.each do |price| %>
                  <tr>
                    <td class="border p-3">
                      <%= price.floor_number ? "#{price.floor_number}階" : "全階共通" %>
                    </td>
                    <td class="border p-3">
                      <% if price.start_time && price.end_time %>
                        <%= price.start_time.strftime("%H:%M") %>〜<%= price.end_time.strftime("%H:%M") %>
                      <% else %>
                        終日
                      <% end %>
                    </td>
                    <td class="border p-3 font-semibold">
                      <%= number_with_precision(price.price_per_ball, precision: 2, strip_insignificant_zeros: true) %>円/球
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if @golf_range.official_website_url.present? %>
      <div class="mt-8">
        <%= link_to "公式サイトを見る",
            @golf_range.official_website_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-block rounded-lg bg-green-800 px-6 py-3 font-semibold text-white hover:bg-green-900" %>
      </div>
    <% end %>
  </div>
</div>